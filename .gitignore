# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# --- Environment & Secrets ---
.env
*.env.local
*.env.production
cookie*.txt
TOOLS.md
USER.md

# --- Database ---
*.db
*.sqlite
*.sqlite3

# 🚫 FORBIDDEN ZONE: لا يحفظ أي ملف جديد في جذر المشروع!
# أي ملف جديد يجب أن يكون ضمن:
# - tests/
# - scripts/
# - temp_orig/  (للتخزين المؤقت فقط)
# المخالفات سيتم رفضها تلقائياً في pre-push
# ====================================

# ⛔ منع حفظ ملفات في الجذر:
# - أي ملف Python جديد خارج المجلدات المسموحة
# - أي ملف نصي أو JSON داعم
# - أي ملف اختبار أو تشخيص

# السماح فقط بالملفات الأساسية في الجذر:
# server.py, app.py, Procfile, requirements.txt, prompt.txt, .env, .gitignore

# --- Temp / Unwanted ---
_fix_*.py
_patch_*.py
_[a-z]*.py
# But keep __init__.py (Python packages need it)
!__init__.py
temp/
tmp/
*.tmp
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.sublime-*

# --- Database WAL/SHM ---
*.db-shm
*.db-wal

# --- Sub-agent workspace ---
customer_support/
royal-agent-tool/
skills/

# --- Temp originals ---
temp_orig/

# --- Logs ---
*.log
logs/

# --- Node ---
node_modules/

# --- Memory notes ---
memory/

# --- OpenClaw state ---
openclaw-workspace-state.json
