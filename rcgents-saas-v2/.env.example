# ═══════════════════════════════════════════════════════════
# RC Agents v2 — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
APP_NAME=RC Agents v2
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret

# ── Database ─────────────────────────────────────────
# Railway provides this automatically via ${{DATABASE_URL}}
# For local dev: sqlite:///./dev.db
DATABASE_URL=postgresql://user:pass@host:5432/rcagents

# ── Shopify ──────────────────────────────────────────
SHOPIFY_SHOP_URL=rwqchh-na.myshopify.com
SHOPIFY_CATALOG_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ORDERS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Meta (Messenger / Instagram) ─────────────────────
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_VERIFY_TOKEN=your-verify-token
META_BUSINESS_ACCOUNT_ID=your-instagram-business-id

# ── WhatsApp Cloud API ───────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# ── AI / DeepSeek ───────────────────────────────────
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
AI_API_KEY=your-deepinfra-api-key
AI_API_BASE=https://api.deepinfra.com/v1/openai/chat/completions
AI_SYSTEM_PROMPT=

# ── ZR Express Shipping ──────────────────────────────
ZR_API_KEY=your-zr-api-key
ZR_BASE_URL=https://api.zrexpress.dz

# ── Domains ──────────────────────────────────────────
BASE_URL=https://rcagent.space
DOMAIN=rcagent.space
