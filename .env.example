# ============================================================
# Royal Chaussures - Render.com Environment Variables
# ============================================================
# انسخ هذا الملف إلى .env وأضف القيم الصحيحة
# أو أضف هذه المتغيرات في Render Dashboard → Environment

# Shopify
SHOPIFY_STORE=rwqchh-na
SHOPIFY_API_VERSION=2024-10
SHOPIFY_CATALOG_TOKEN=your_shopify_catalog_token_here
SHOPIFY_ORDERS_TOKEN=your_shopify_orders_token_here

# ZR Express
ZR_BASE_URL=https://api.zrexpress.app/api/v1
ZR_TENANT_ID=your_zr_tenant_id_here
ZR_API_KEY=your_zr_api_key_here

# Meta Platform
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
FB_SYSTEM_USER_TOKEN=your_fb_system_user_token_here

# Instagram
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

# Logging
LOG_LEVEL=INFO
